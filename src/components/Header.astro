---
const path = Astro.url.pathname;
const links = [["Projects","/projects"],["About","/about"],["Contact","/contact"]];
---
<header class="site-header"><a class="mark" href="/" aria-label="Emiliano Ruiz Gomez, home">ERG<span> / 26</span></a><nav aria-label="Primary navigation">{links.map(([label,href]) => <a href={href} aria-current={path.startsWith(href) ? "page" : undefined}>{label}</a>)}</nav></header>
<style>
.site-header{display:flex;min-height:5rem;border-bottom:1px solid var(--line)}.mark{display:flex;align-items:center;padding:0 var(--pad);border-right:1px solid var(--line);font-weight:800;text-decoration:none;letter-spacing:-.04em}.mark span{color:var(--accent)}nav{display:flex;align-items:stretch;margin-left:auto}nav a{display:flex;align-items:center;padding:0 clamp(.8rem,2vw,1.5rem);border-left:1px solid var(--line);font-size:.72rem;font-weight:700;letter-spacing:.08em;text-decoration:none;text-transform:uppercase}nav a[aria-current=page]{background:var(--accent);color:var(--accent-ink)}@media(max-width:560px){.site-header{min-height:auto;flex-wrap:wrap}.mark{width:100%;min-height:3.5rem;border-right:0}nav{width:100%;border-top:1px solid var(--line)}nav a{flex:1;justify-content:center;min-height:3rem}}
</style>
