---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects, type Project } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: Project };
---
<BaseLayout title={project.title} description={project.summary} image={`/projects/${project.slug}.svg`}><section class="project-hero"><div><p class="eyebrow">{project.index} / {project.status}</p><h1 class="title">{project.title}</h1></div><div><p class="lede">{project.summary}</p><ul class="tag-list">{project.technologies.map(t=><li>{t}</li>)}</ul></div></section><section class="project-proof"><span>Verified proof point</span><p>{project.proof}</p></section><section class="grid-2 prose"><div><p class="eyebrow">Problem</p><h2>Why this exists</h2></div><div><p class="lede">{project.problem}</p></div></section><section class="grid-2 prose"><div><p class="eyebrow">Role</p><h2>What I owned</h2><p>{project.role}</p></div><div><h3>Original contribution</h3><ul>{project.contributions.map(i=><li>{i}</li>)}</ul></div></section><section class="section prose architecture"><p class="eyebrow">System / Architecture</p><h2>How it works</h2><ol>{project.architecture.map((item,i)=><li><span>{String(i+1).padStart(2,"0")}</span><p>{item}</p></li>)}</ol></section>{project.benchmarks&&<section class="section benchmarks prose"><p class="eyebrow">Evidence / Protocol included</p><h2>Measured results</h2><div class="benchmark-grid">{project.benchmarks.map(b=><article><h3>{b.metric}</h3><p class="result">{b.result}</p><p class="meta muted">{b.protocol}</p></article>)}</div></section>}<section class="grid-2 prose limitations"><div><p class="eyebrow">Limits</p><h2>What this does not prove</h2></div><div><ul>{project.limitations.map(i=><li>{i}</li>)}</ul></div></section><section class="section next"><p class="eyebrow">Inspect the work</p><h2 class="title">See the artifact, not just the claim.</h2><div class="actions">{project.links.map(l=><a class:list={["button",l.kind==="demo"&&"primary"]} href={l.href}>{l.label} ↗</a>)}<a class="button" href="/projects">All projects</a></div></section></BaseLayout>
<style>.project-hero{display:grid;grid-template-columns:1.2fr 1fr;min-height:60vh}.project-hero>*{display:flex;flex-direction:column;justify-content:flex-end;padding:clamp(3rem,8vw,8rem) var(--pad)}.project-hero>*+*{border-left:1px solid var(--line)}.project-proof{padding:2rem var(--pad);border-top:1px solid var(--line);background:var(--accent);color:var(--accent-ink)}.project-proof span{font-size:.7rem;font-weight:700;text-transform:uppercase}.project-proof p{max-width:55rem;margin:.8rem 0 0;font-size:clamp(1.35rem,3vw,2.6rem);line-height:1.08}.architecture ol{margin:3rem 0 0;padding:0;border-top:1px solid var(--line);list-style:none}.architecture li{display:grid;grid-template-columns:5rem 1fr;padding:1.2rem 0;border-bottom:1px solid var(--line)}.architecture span{color:var(--accent);font-weight:700}.architecture p{margin:0}.benchmark-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line)}.benchmark-grid article{padding:1.5rem;border-right:1px solid var(--line)}.result{color:var(--accent);font-size:clamp(1.8rem,3vw,3rem);font-weight:700;line-height:1}.limitations{background:color-mix(in srgb,var(--accent) 7%,var(--paper))}.next{min-height:50vh}@media(max-width:760px){.project-hero,.benchmark-grid{grid-template-columns:1fr}.project-hero>*+*{border-left:0;border-top:1px solid var(--line)}.benchmark-grid article{border-right:0;border-bottom:1px solid var(--line)}}</style>
